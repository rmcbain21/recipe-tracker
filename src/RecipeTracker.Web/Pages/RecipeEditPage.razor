@page "/recipes/new"
@page "/recipes/{RecipeId}/edit"
@using RecipeTracker.Core.Recipes
@inject AppCore App

<PageTitle>@Heading</PageTitle>

@if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_editor is null)
{
    <MudText Typo="Typo.h5" HtmlTag="h1">Recipe not found</MudText>
    <MudText Class="mud-text-secondary">It may have been deleted.</MudText>
}
else
{
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-2">@Heading</MudText>
    <RecipeSaveActions Editor="_editor" Finishing="_editor.IsDraft" CancelHref="@CancelHref" Class="mb-3" />
    <RecipeEditorForm Editor="_editor" AutoFocusTitle="@(RecipeId is null)" />
    <RecipeSaveActions Editor="_editor" Finishing="_editor.IsDraft" CancelHref="@CancelHref" Class="mb-6" />
}

@code {
    [Parameter]
    public string? RecipeId { get; set; }

    private RecipeEditor? _editor;
    private bool _loaded;

    private string Heading => RecipeId is null ? "New Recipe" : _editor?.IsDraft == true ? "Edit Draft" : "Edit Recipe";

    private string CancelHref => RecipeId is null ? "" : $"recipes/{RecipeId}";

    protected override async Task OnParametersSetAsync()
    {
        if (RecipeId is null)
        {
            _editor = App.Recipes.NewRecipe();
            _editor.AddLine(_editor.Sections[0]);
            _editor.AddStep();
        }
        else
        {
            _editor = await App.Recipes.EditRecipeAsync(RecipeId);
        }

        _loaded = true;
    }
}
