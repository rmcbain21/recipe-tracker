@page "/recipes/{RecipeId}/cook"
@using RecipeTracker.Core.Cooking
@using RecipeTracker.Core.Parsing
@using RecipeTracker.Core.Ports
@using RecipeTracker.Core.Quantities
@implements IAsyncDisposable
@inject AppCore App
@inject IClock Clock
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_view?.Recipe.Title ?? "Cooking")</PageTitle>

@* Full screen over the app bar. Gather first, then one Step per screen; Back and Next sit at the bottom, and swiping works too. *@
<div class="cooking @(_session?.OnGather == true ? "on-gather" : "on-step")" tabindex="-1" @ref="_root"
     @onkeydown="OnKeyDownAsync" @ontouchstart="OnTouchStart" @ontouchend="OnTouchEndAsync">
    <header class="cooking-top">
        <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Exit Cooking Mode" OnClick="Exit" Class="cooking-exit" />
        <div class="flex-grow-1 cooking-title">
            <MudText Typo="Typo.subtitle1" Class="text-truncate">@_view?.Recipe.Title</MudText>
            @if (_session is not null && _view is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary cooking-where">
                    @(_session.OnGather ? "Gather" : $"Step {_session.Position} of {_view.Recipe.Steps.Count}")@(_scale.IsOne ? "" : $" · {_scale.Label}")
                </MudText>
            }
        </div>
    </header>

    @* Running and finished timers, on Gather and every Step. A finished one flashes and rings until dismissed. *@
    @if (_session is { Timers.Count: > 0 } && _error is null)
    {
        var now = Clock.UtcNow;
        <section class="timer-strip" aria-label="Timers">
            @foreach (var timer in _session.Timers)
            {
                var done = timer.IsFinished(now);
                <div class="timer @(done ? "finished" : "")" @key="timer.Id">
                    <MudIcon Icon="@(done ? Icons.Material.Filled.AlarmOn : Icons.Material.Filled.Timer)" Size="Size.Small" />
                    <span class="timer-label">@timer.Label</span>
                    <span class="timer-left">@(done ? "Done" : timer.Countdown(now))</span>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => AddFiveAsync(timer.Id)" Class="timer-more">+5 min</MudButton>
                    @if (done)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => RemoveTimerAsync(timer.Id)">Dismiss</MudButton>
                    }
                    else
                    {
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" aria-label="@($"Cancel the {timer.Label} timer")"
                                       OnClick="() => RemoveTimerAsync(timer.Id)" />
                    }
                </div>
            }
        </section>
    }

    @if (_error is not null)
    {
        <main class="cooking-body pa-4">
            <MudAlert Severity="Severity.Warning">@_error</MudAlert>
            <MudButton Href="@($"recipes/{RecipeId}")" Class="mt-2">Back to the Recipe</MudButton>
        </main>
    }
    else if (_session is null || _view is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_session.OnGather)
    {
        <main class="cooking-body cooking-gather">
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-2">Gather</MudText>
            @if (_view.Recipe.Lines.Any(line => line.Quantity is not null))
            {
                <ScaleControl Yield="_view.Recipe.Yield" Value="_scale" ValueChanged="SetScaleAsync" Large="true" Class="mb-3" />
            }
            @if (_view.Ingredients.Count == 0)
            {
                <MudText Class="mud-text-secondary">Nothing to gather.</MudText>
            }
            @foreach (var group in _view.Ingredients)
            {
                @if (group.Heading is not null)
                {
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mt-2 ingredient-heading">@group.Heading</MudText>
                }
                @foreach (var line in group.Lines)
                {
                    var ticked = _session.GatherTicks.Contains(line.Line.Id);
                    <div class="gather-row @(ticked ? "ticked" : "")" @key="line.Line.Id">
                        <MudCheckBox T="bool" Value="ticked" ValueChanged="v => TickAsync(line.Line.Id, v)" Size="Size.Large"
                                     Color="Color.Primary" Label="@line.Text" />
                    </div>
                }
            }
        </main>
    }
    else
    {
        var steps = _view.Recipe.Steps;
        var index = _session.StepIndex!.Value;
        var step = steps[index];
        var uses = _view.UsesFor(step);
        var used = uses.Select(u => u.Use.LineId).ToHashSet();
        var notes = _view.NotesForStep(step);
        <main class="cooking-body cooking-steps">
            @* The ingredients pane: on the left on a tablet in landscape; a collapsible section above
               the Step in portrait. "This step" lists the Step's ingredients and amounts, and "All"
               lists every line with the Step's highlighted. *@
            <aside class="cooking-lines @(_paneOpen ? "open" : "")" aria-label="Ingredients">
                <button type="button" class="pane-toggle" aria-expanded="@(_paneOpen ? "true" : "false")"
                        @onclick="() => _paneOpen = !_paneOpen">
                    <MudIcon Icon="@Icons.Material.Filled.Kitchen" Size="Size.Small" />
                    <span class="flex-grow-1">Ingredients</span>
                    <span class="mud-text-secondary pane-count">@(_showAll ? "showing all" : $"{uses.Count} in this step")</span>
                    <MudIcon Icon="@(_paneOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                </button>
                <div class="pane-content">
                    <MudButtonGroup Size="Size.Small" Color="Color.Primary" OverrideStyles="false" Class="mb-2 pane-mode">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_showAll ? Variant.Outlined : Variant.Filled)" OnClick="() => _showAll = false"
                                   aria-pressed="@(_showAll ? "false" : "true")">This step</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_showAll ? Variant.Filled : Variant.Outlined)" OnClick="() => _showAll = true"
                                   aria-pressed="@(_showAll ? "true" : "false")">All</MudButton>
                    </MudButtonGroup>
                    @if (!_showAll)
                    {
                        @if (uses.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-1">No ingredients in this step.</MudText>
                        }
                        <ul class="pane-step">
                            @foreach (var use in uses)
                            {
                                <li class="in-step">@use.Text</li>
                            }
                        </ul>
                    }
                    else
                    {
                        @foreach (var group in _view.Ingredients)
                        {
                            @if (group.Heading is not null)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-2">@group.Heading</MudText>
                            }
                            <ul class="pane-all">
                                @foreach (var line in group.Lines)
                                {
                                    <li class="@(used.Contains(line.Line.Id) ? "in-step" : "")">@line.Text</li>
                                }
                            </ul>
                        }
                    }
                </div>
            </aside>
            <section class="cooking-step">
                @if (index > 0)
                {
                    <p class="step-faded step-before" @onclick="BackAsync">@steps[index - 1].Text</p>
                }
                <MudText Typo="Typo.overline" Class="step-label">Step @(index + 1)</MudText>
                @* Each time in the Step's text is a chip that starts a timer, and shows its time left while it runs. *@
                <p class="step-now">
                    @foreach (var (text, time) in Segments(step.Text))
                    {
                        if (time is null)
                        {
                            @text
                        }
                        else
                        {
                            var running = _session.Timers.FirstOrDefault(t => t.StepId == step.Id && t.TextStart == time.Start);
                            <button type="button" class="timer-chip @(running is null ? "" : "running")"
                                    aria-label="@(running is null ? $"Start a {time.Label} timer" : $"{time.Label} timer running")"
                                    @onclick="() => StartTimerAsync(step.Id, time)">
                                <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                                <span>@text</span>
                                @if (running is not null)
                                {
                                    <span class="chip-left">@(running.IsFinished(Clock.UtcNow) ? "done" : running.Countdown(Clock.UtcNow))</span>
                                }
                            </button>
                        }
                    }
                </p>
                @if (uses.Count > 0)
                {
                    <ul class="step-now-uses">
                        @foreach (var use in uses)
                        {
                            <li>@use.Text</li>
                        }
                    </ul>
                }
                @if (notes.Count > 0)
                {
                    <div class="note-list mb-2 step-now-notes">
                        @foreach (var note in notes)
                        {
                            <div class="note d-flex align-start gap-1">
                                <MudIcon Icon="@Icons.Material.Outlined.StickyNote2" Size="Size.Small" Class="mt-1 note-icon" />
                                <MudText Typo="Typo.body1" Class="note-text">
                                    @if (note.About is not null)
                                    {
                                        <strong>@note.About: </strong>
                                    }
                                    @note.Note.Text
                                </MudText>
                            </div>
                        }
                    </div>
                }
                @if (index < steps.Count - 1)
                {
                    <p class="step-faded step-after" @onclick="NextAsync">@steps[index + 1].Text</p>
                }
            </section>
        </main>
    }

    @if (_session is not null && _view is not null && _error is null)
    {
        var isLast = _session.Position >= _view.Recipe.Steps.Count;
        <footer class="cooking-nav">
            <MudButton Variant="Variant.Outlined" Size="Size.Large" StartIcon="@Icons.Material.Filled.ArrowBack"
                       Disabled="_session.OnGather || _busy" OnClick="BackAsync" Class="cooking-back">Back</MudButton>
            @if (isLast)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Filled.Check"
                           Disabled="_busy" OnClick="FinishAsync" Class="cooking-next">Finish</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Filled.ArrowForward"
                           Disabled="_busy" OnClick="NextAsync" Class="cooking-next">@(_session.OnGather ? "Start" : "Next")</MudButton>
            }
        </footer>
    }
</div>

@code {
    [Parameter]
    public string RecipeId { get; set; } = "";

    private ElementReference _root;
    private IJSObjectReference? _wakeLock;
    private RecipeView? _view;
    private CookingSession? _session;
    private Scale _scale = Scale.One;
    private string? _error;
    private bool _busy;

    // The ingredients pane: "All" or "This step", and whether it's open in portrait. Both last while
    // the page is open, so they carry from Step to Step.
    private bool _showAll;
    private bool _paneOpen;
    private (double X, double Y)? _touchStart;

    protected override async Task OnParametersSetAsync()
    {
        var view = await App.Recipes.GetRecipeAsync(RecipeId);
        if (view is null)
        {
            _error = "This Recipe has been deleted.";
            return;
        }

        try
        {
            // Opening Cooking Mode directly (a bookmark, a reload) resumes, or starts at ×1.
            _session = await App.Cooking.GetSessionAsync(RecipeId) ?? await App.Cooking.StartAsync(RecipeId, Scale.One);
        }
        catch (RuleViolationException ex)
        {
            _error = ex.Message;
            return;
        }

        _scale = Scale.By(_session.ScaleFactor);
        _view = view.AtScale(_scale);
    }

    // The screen last focused for the arrow keys.
    private int? _focusedPosition;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Moving to another screen re-renders the buttons and drops focus to the page, so take it
        // back for the arrow keys (a tablet with a keyboard). Not while typing in the Scale box.
        if (_session is not null && _session.Position != _focusedPosition)
        {
            _focusedPosition = _session.Position;
            await _root.FocusAsync(preventScroll: true);
        }

        if (firstRender)
        {
            try
            {
                _wakeLock = await JS.InvokeAsync<IJSObjectReference>("import", "./js/wakeLock.js");
                await _wakeLock.InvokeAsync<bool>("keepAwake");
            }
            catch (JSException)
            {
                // No Wake Lock here; the screen may sleep, and everything else still works.
            }

            try
            {
                _alarm = await JS.InvokeAsync<IJSObjectReference>("import", "./js/timerAlarm.js");
            }
            catch (JSException)
            {
                // No alarm sound; finished timers still flash.
            }

            _ = TickAsync();
        }
    }

    // Timers: the clock ticks once a second while any exist, and rings while any have finished.
    private IJSObjectReference? _alarm;
    private readonly CancellationTokenSource _closing = new();
    private bool _ringing;

    private async Task TickAsync()
    {
        using var ticker = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await ticker.WaitForNextTickAsync(_closing.Token))
            {
                if (_session is { Timers.Count: > 0 } || _ringing)
                {
                    await UpdateAlarmAsync();
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Cooking Mode closed.
        }
    }

    private async Task UpdateAlarmAsync()
    {
        var now = Clock.UtcNow;
        var ring = _session?.Timers.Any(t => t.IsFinished(now)) == true;
        if (ring == _ringing || _alarm is null)
        {
            return;
        }

        _ringing = ring;
        try
        {
            await _alarm.InvokeVoidAsync(ring ? "start" : "stop");
        }
        catch (JSException)
        {
            // No sound; the timer still flashes.
        }
    }

    private async Task StartTimerAsync(string stepId, StepDuration time)
    {
        // A tap, so the browser now lets the page make the alarm sound later.
        if (_alarm is not null)
        {
            try
            {
                await _alarm.InvokeVoidAsync("prime");
            }
            catch (JSException)
            {
                // No sound.
            }
        }

        await Change(() => App.Cooking.StartTimerAsync(RecipeId, stepId, time));
    }

    private async Task AddFiveAsync(string timerId)
    {
        await Change(() => App.Cooking.AddTimeAsync(RecipeId, timerId, TimeSpan.FromMinutes(5)));
        await UpdateAlarmAsync();
    }

    private async Task RemoveTimerAsync(string timerId)
    {
        await Change(() => App.Cooking.RemoveTimerAsync(RecipeId, timerId));
        await UpdateAlarmAsync();
    }

    /// <summary>The Step's text cut into plain text and the times found in it.</summary>
    private static IEnumerable<(string Text, StepDuration? Time)> Segments(string text)
    {
        var at = 0;
        foreach (var time in StepDurations.Find(text))
        {
            if (time.Start > at)
            {
                yield return (text[at..time.Start], null);
            }

            yield return (text.Substring(time.Start, time.Length), time);
            at = time.Start + time.Length;
        }

        if (at < text.Length)
        {
            yield return (text[at..], null);
        }
    }

    private async Task Change(Func<Task<CookingSession>> change)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _session = await change();
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task NextAsync() =>
        _session is not null && _session.Position < _view!.Recipe.Steps.Count ? Change(() => App.Cooking.NextAsync(RecipeId)) : Task.CompletedTask;

    private Task BackAsync() =>
        _session is { OnGather: false } ? Change(() => App.Cooking.BackAsync(RecipeId)) : Task.CompletedTask;

    private Task TickAsync(string lineId, bool ticked) => Change(() => App.Cooking.TickAsync(RecipeId, lineId, ticked));

    private async Task SetScaleAsync(Scale scale)
    {
        await Change(() => App.Cooking.SetScaleAsync(RecipeId, scale));
        _scale = Scale.By(_session!.ScaleFactor);
        _view = _view!.AtScale(_scale);
    }

    // Ends the session and returns to the recipe page. Ticket 11 adds the Cook Log Entry here.
    private async Task FinishAsync()
    {
        await App.Cooking.EndAsync(RecipeId);
        Navigation.NavigateTo($"recipes/{RecipeId}", replace: true);
    }

    // ✕ keeps the session, so starting again offers Resume.
    private void Exit() => Navigation.NavigateTo($"recipes/{RecipeId}");

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight" or "PageDown":
                await NextAsync();
                break;
            case "ArrowLeft" or "PageUp":
                await BackAsync();
                break;
            case "Escape":
                Exit();
                break;
        }
    }

    private void OnTouchStart(TouchEventArgs e)
    {
        _touchStart = e.Touches.Length == 1 ? (e.Touches[0].ClientX, e.Touches[0].ClientY) : null;
    }

    // A mostly sideways swipe of at least 60 px: right to left is Next, left to right is Back.
    private async Task OnTouchEndAsync(TouchEventArgs e)
    {
        if (_touchStart is not { } start || e.ChangedTouches.Length == 0)
        {
            return;
        }

        _touchStart = null;
        var dx = e.ChangedTouches[0].ClientX - start.X;
        var dy = e.ChangedTouches[0].ClientY - start.Y;
        if (Math.Abs(dx) < 60 || Math.Abs(dx) < Math.Abs(dy) * 1.5)
        {
            return;
        }

        await (dx < 0 ? NextAsync() : BackAsync());
    }

    public async ValueTask DisposeAsync()
    {
        _closing.Cancel();

        try
        {
            if (_alarm is not null)
            {
                await _alarm.InvokeVoidAsync("stop");
                await _alarm.DisposeAsync();
            }

            if (_wakeLock is not null)
            {
                await _wakeLock.InvokeVoidAsync("release");
                await _wakeLock.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is closing; the browser releases the lock and stops the sound itself.
        }

        _closing.Dispose();
    }
}
