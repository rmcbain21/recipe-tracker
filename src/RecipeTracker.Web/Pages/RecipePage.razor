@page "/recipes/{RecipeId}"
@using RecipeTracker.Core.Recipes
@using RecipeTracker.Core.Quantities
@inject AppCore App
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_view?.Recipe.Title ?? "Recipe")</PageTitle>

<MudButton Href="./" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack"
           Class="mb-1 ml-n2">Recipes</MudButton>

@if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_view is null)
{
    <MudText Typo="Typo.h5" HtmlTag="h1">Recipe not found</MudText>
    <MudText Class="mud-text-secondary">It may have been deleted.</MudText>
}
else
{
    var recipe = _view.Recipe;
    <div class="d-flex align-center">
        <MudText Typo="Typo.h5" HtmlTag="h1" Class="flex-grow-1">@recipe.Title</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit Recipe" Href="@($"recipes/{recipe.Id}/edit")" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AriaLabel="Recipe options">
            <MudMenuItem OnClick="() => AddNoteAsync(null, recipe.Title)">Add a Note</MudMenuItem>
            <MudMenuItem OnClick="DeleteAsync">Delete</MudMenuItem>
        </MudMenu>
    </div>

    @if (recipe.IsDraft)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2 draft-note">
            This is a Draft. <MudLink Href="@($"recipes/{recipe.Id}/edit")">Finish reviewing it</MudLink> to cook from it.
        </MudAlert>
    }

    @if (_view.Source is { } source)
    {
        <MudText Typo="Typo.body2" Class="mb-2 recipe-source">
            From
            @if (source.Url is not null)
            {
                <MudLink Href="@source.Url" Target="_blank" rel="noopener">@source.Name</MudLink>
            }
            else if (source.Kind == SourceKind.Book)
            {
                <em>@source.Name</em>@source.PageText
            }
            else
            {
                @source.Name
            }
        </MudText>
    }

    <TagChips Groups="_view.Tags" Class="mb-2 recipe-tags">
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Sell" OnClick="EditTagsAsync" Class="edit-tags">
            @(_view.Tags.Count == 0 ? "Add Tags" : "Edit")
        </MudButton>
    </TagChips>

    @if (recipe.Description.Length > 0)
    {
        <MudText Typo="Typo.body1" Class="mb-2 recipe-description">@recipe.Description</MudText>
    }

    @if (_view.RecipeNotes.Count > 0)
    {
        <NoteList Notes="_view.RecipeNotes" OnEdit="EditNoteAsync" OnDelete="DeleteNoteAsync" Class="mb-3 recipe-notes" />
    }

    @if (recipe.Yield is not null || !recipe.StatedTimes.IsEmpty)
    {
        <div class="d-flex flex-wrap gap-4 mb-3 recipe-facts">
            @if (recipe.Yield is not null)
            {
                @Fact("Makes", _view.YieldText!)
            }
            @if (recipe.StatedTimes.PrepMinutes is int prep)
            {
                @Fact("Prep", StatedTimes.Format(prep))
            }
            @if (recipe.StatedTimes.CookMinutes is int cook)
            {
                @Fact("Cook", StatedTimes.Format(cook))
            }
            @if (recipe.StatedTimes.TotalMinutes is int total)
            {
                @Fact("Total", StatedTimes.Format(total))
            }
        </div>
    }

    @if (recipe.Lines.Any(line => line.Quantity is not null))
    {
        <div class="d-flex flex-wrap align-center gap-1 mb-2 scale-control" role="group" aria-label="Scale">
            <MudText Typo="Typo.caption" Class="mud-text-secondary mr-1">Scale</MudText>
            @foreach (var preset in Scale.Presets)
            {
                var chosen = _scale == preset;
                <MudChip T="string" Size="Size.Small" Class="ml-0 scale-preset" Color="@(chosen ? Color.Primary : Color.Default)"
                         Variant="@(chosen ? Variant.Filled : Variant.Outlined)" aria-pressed="@(chosen ? "true" : "false")"
                         OnClick="() => SetScale(preset)">@preset.Label</MudChip>
            }
            @* Any other multiplier, such as ×10 for a bulk batch. *@
            <MudTextField T="string" Value="_customScale" ValueChanged="SetCustomScale" Placeholder="other"
                          Adornment="Adornment.Start" AdornmentText="×" Margin="Margin.Dense" Variant="Variant.Outlined"
                          Validation="@(new Func<string, string?>(CustomScaleError))" InputMode="@(InputMode.@decimal)"
                          Class="@($"field-custom-scale{(_customScale.Length > 0 ? " custom-scale-on" : "")}")" aria-label="Other Scale" />
            @if (recipe.Yield is { Amount: > 0 } yield)
            {
                <span class="d-inline-flex align-center gap-1 ml-1 scale-yield">
                    <MudText Typo="Typo.body2">Make</MudText>
                    <MudNumericField T="decimal?" Value="ScaledYieldAmount(yield)" ValueChanged="v => ScaleToYield(yield, v)"
                                     Min="0" HideSpinButtons="true" Margin="Margin.Dense" Variant="Variant.Outlined" Format="0.##"
                                     Class="field-yield" aria-label="@($"Make how many {yield.Label}")" />
                    <MudText Typo="Typo.body2">@yield.Label</MudText>
                </span>
            }
        </div>
    }

    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-2">Ingredients</MudText>
    @if (_view.Ingredients.Count == 0)
    {
        <MudText Class="mud-text-secondary">No ingredients yet.</MudText>
    }
    @foreach (var group in _view.Ingredients)
    {
        @if (group.Heading is not null)
        {
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mt-2 ingredient-heading">@group.Heading</MudText>
        }
        <ul class="ingredient-lines">
            @foreach (var line in group.Lines)
            {
                <li @key="line.Line.Id">@Noted(line.Line.Id, line.Text)</li>
            }
        </ul>
    }

    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-4">Steps</MudText>
    @if (recipe.Steps.Count == 0)
    {
        <MudText Class="mud-text-secondary">No steps yet.</MudText>
    }
    else
    {
        <ol class="recipe-steps">
            @foreach (var step in recipe.Steps)
            {
                var uses = _view.UsesFor(step);
                <li @key="step.Id">@Noted(step.Id, step.Text, uses.Count == 0 ? null : string.Join(" · ", uses.Select(u => u.Text)))</li>
            }
        </ol>
    }
}

@code {
    [Parameter]
    public string RecipeId { get; set; } = "";

    private RecipeView? _view;

    // The Scale is only for this visit to the page: it's never saved, and opening the page resets it.
    private Scale _scale = Scale.One;

    // What the "other" box shows: blank on a preset, otherwise the Scale in use (typed, or from "Make N").
    private string _customScale = "";

    private void SetScale(Scale scale)
    {
        _scale = scale;
        _view = _view!.AtScale(scale);
        _customScale = Scale.Presets.Contains(scale) ? "" : scale.Label.TrimStart('×');
    }

    private void SetCustomScale(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            SetScale(Scale.One);
        }
        else if (Scale.TryParse(text, out var scale))
        {
            SetScale(scale!);
        }
        else
        {
            _customScale = text; // keep what was typed so the error shows against it
        }
    }

    private static string? CustomScaleError(string? text) =>
        string.IsNullOrWhiteSpace(text) || Scale.TryParse(text, out _) ? null : $"Try 4 or 2½ (up to ×{Scale.MaxFactor:0})";

    private decimal? ScaledYieldAmount(Yield yield) => Math.Round(yield.Amount!.Value * _scale.Factor, 2);

    private void ScaleToYield(Yield yield, decimal? target)
    {
        if (target is > 0)
        {
            SetScale(Scale.ToYield(yield, target.Value));
        }
    }
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        _scale = Scale.One;
        _customScale = "";
        _view = (await App.Recipes.GetRecipeAsync(RecipeId))?.AtScale(_scale);
        _loaded = true;
    }

    private async Task DeleteAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Recipe?", $"\"{_view!.Recipe.Title}\" will be deleted.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await App.Recipes.DeleteRecipeAsync(RecipeId);
        Navigation.NavigateTo("", replace: true);
    }

    // A line's or Step's text with its Notes: a note button (with the count) that expands them in
    // place, and a ⋯ menu to add one. A long-press (the context menu) adds one too.
    // A Step's Ingredient Uses show under its text, as subtext.
    private RenderFragment Noted(string targetId, string text, string? subtext = null) => __builder =>
    {
        var notes = _view!.NotesFor(targetId);
        var open = _openNotes.Contains(targetId);
        <div class="noted d-flex align-start gap-1" @oncontextmenu="() => AddNoteAsync(targetId, text)" @oncontextmenu:preventDefault="true">
            <div class="flex-grow-1">
                <span class="noted-text">@text</span>
                @if (subtext is not null)
                {
                    <div class="step-uses mud-text-secondary">@subtext</div>
                }
            </div>
            @if (notes.Count > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Class="note-toggle"
                           StartIcon="@(open ? Icons.Material.Filled.StickyNote2 : Icons.Material.Outlined.StickyNote2)"
                           aria-expanded="@(open ? "true" : "false")" aria-label="@($"{notes.Count} {(notes.Count == 1 ? "Note" : "Notes")}")"
                           OnClick="() => ToggleNotes(targetId)">@notes.Count</MudButton>
            }
            <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true" AriaLabel="Line options" Class="noted-menu">
                <MudMenuItem OnClick="() => AddNoteAsync(targetId, text)">Add a Note</MudMenuItem>
            </MudMenu>
        </div>
        @if (open && notes.Count > 0)
        {
            <NoteList Notes="notes" OnEdit="EditNoteAsync" OnDelete="DeleteNoteAsync" Class="mb-2" />
        }
    };

    private readonly HashSet<string> _openNotes = [];

    private void ToggleNotes(string targetId)
    {
        if (!_openNotes.Remove(targetId))
        {
            _openNotes.Add(targetId);
        }
    }

    private async Task AddNoteAsync(string? targetId, string about)
    {
        var parameters = new DialogParameters<NoteDialog> { { d => d.About, about } };
        var dialog = await DialogService.ShowAsync<NoteDialog>("Add a Note", parameters);
        if (await dialog.Result is not { Canceled: false, Data: string text })
        {
            return;
        }

        await RunAsync(() => App.Recipes.AddNoteAsync(RecipeId, targetId, text));
        if (targetId is not null)
        {
            _openNotes.Add(targetId);
        }
    }

    private async Task EditNoteAsync(Note note)
    {
        var parameters = new DialogParameters<NoteDialog> { { d => d.CurrentText, note.Text } };
        var dialog = await DialogService.ShowAsync<NoteDialog>("Edit Note", parameters);
        if (await dialog.Result is { Canceled: false, Data: string text })
        {
            await RunAsync(() => App.Recipes.EditNoteAsync(RecipeId, note.Id, text));
        }
    }

    private async Task DeleteNoteAsync(Note note)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Note?", $"\"{note.Text}\" will be deleted.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            await RunAsync(() => App.Recipes.DeleteNoteAsync(RecipeId, note.Id));
        }
    }

    private async Task EditTagsAsync()
    {
        var parameters = new DialogParameters<TagPickerDialog> { { d => d.Picked, _view!.Recipe.TagIds } };
        var dialog = await DialogService.ShowAsync<TagPickerDialog>("Tags", parameters);
        if (await dialog.Result is { Canceled: false, Data: List<string> picked })
        {
            await RunAsync(() => App.Recipes.SetTagsAsync(RecipeId, picked));
        }
    }

    // Runs a Note or Tag change, shows a rule it breaks, and reloads the Recipe either way.
    private async Task RunAsync(Func<Task> change)
    {
        try
        {
            await change();
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }

        _view = (await App.Recipes.GetRecipeAsync(RecipeId))?.AtScale(_scale);
    }

    private static RenderFragment Fact(string label, string value) => __builder =>
    {
        <div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@label</MudText>
            <MudText Typo="Typo.body1">@value</MudText>
        </div>
    };
}
