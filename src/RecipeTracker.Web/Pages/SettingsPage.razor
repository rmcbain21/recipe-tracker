@page "/settings"

@* For now only links to the Books and Tags pages. Sync, backup, Appearance and Text size arrive with issue 02, and Ingredients with issue 13. *@

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Settings</MudText>

<MudPaper>
    <MudList T="string">
        <MudListItem T="string" Href="books" Icon="@Icons.Material.Filled.LibraryBooks">
            <MudText Typo="Typo.body1">Books</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">The cookbooks your Recipes come from</MudText>
        </MudListItem>
        <MudListItem T="string" Href="tags" Icon="@Icons.Material.Filled.Sell">
            <MudText Typo="Typo.body1">Tags</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Tag Groups and Tags for finding Recipes</MudText>
        </MudListItem>
    </MudList>
</MudPaper>
