@* The home list's filters, as a sheet from the bottom: one row of chips per Tag Group, then
   ungrouped Tags, Source or Book, total time and cooked. Each tap applies straight away, so the
   button at the bottom always says how many Recipes match. *@
@using RecipeTracker.Core.Organizing

@if (Open)
{
    <div class="sheet-backdrop" @onclick="Close"></div>
    <section class="filter-sheet" role="dialog" aria-modal="true" aria-label="Filters" @onkeydown="OnKeyDown">
        <header class="d-flex align-center px-4 pt-3 pb-1">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="flex-grow-1">Filters</MudText>
            <MudButton Variant="Variant.Text" Disabled="Query.FilterCount == 0" OnClick="ClearAsync">Clear</MudButton>
        </header>

        <div class="filter-sheet-body px-4">
            @foreach (var group in Options.Tags)
            {
                <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="filter-row-name">@(group.Group?.Name ?? "Other Tags")</MudText>
                <div class="filter-chips">
                    @foreach (var tag in group.Tags)
                    {
                        var on = Query.TagIds.Contains(tag.Id);
                        @Chip(tag.Name, on, () => SetAsync(Query.WithTag(tag.Id, !on)))
                    }
                </div>
            }

            <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="filter-row-name">Source</MudText>
            <div class="filter-chips">
                @foreach (var kind in Enum.GetValues<SourceKind>())
                {
                    var on = Query.SourceKind == kind && Query.BookId is null;
                    @Chip(RecipeFinder.SourceKindName(kind), on, () => SetAsync(Query with { SourceKind = on ? null : kind, BookId = null }))
                }
            </div>
            @if (Options.Books.Count > 0)
            {
                <div class="filter-chips filter-books">
                    @foreach (var book in Options.Books)
                    {
                        var on = Query.BookId == book.Id;
                        @Chip(book.Title, on, () => SetAsync(Query with { BookId = on ? null : book.Id, SourceKind = on ? null : SourceKind.Book }))
                    }
                </div>
            }

            <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="filter-row-name">Total time</MudText>
            <div class="filter-chips">
                @foreach (var minutes in new[] { 30, 60, 90 })
                {
                    var on = Query.MaxTotalMinutes == minutes;
                    @Chip($"≤ {StatedTimes.Format(minutes)}", on, () => SetAsync(Query with { MaxTotalMinutes = on ? null : minutes }))
                }
            </div>

            <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="filter-row-name">Cooked</MudText>
            <div class="filter-chips">
                @foreach (var (cooked, label) in new[] { (CookedFilter.Cooked, "Cooked"), (CookedFilter.NeverCooked, "Never cooked") })
                {
                    var on = Query.Cooked == cooked;
                    @Chip(label, on, () => SetAsync(Query with { Cooked = on ? CookedFilter.Any : cooked }))
                }
            </div>
        </div>

        <footer class="pa-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" OnClick="Close" Class="filter-show">
                @(MatchCount == 0 ? "No Recipes match" : $"Show {MatchCount} {(MatchCount == 1 ? "Recipe" : "Recipes")}")
            </MudButton>
        </footer>
    </section>
}

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired]
    public RecipeQuery Query { get; set; } = RecipeQuery.Everything;

    [Parameter]
    public EventCallback<RecipeQuery> QueryChanged { get; set; }

    [Parameter, EditorRequired]
    public RecipeFilterOptions Options { get; set; } = new([], []);

    /// <summary>How many Recipes the current filters let through.</summary>
    [Parameter]
    public int MatchCount { get; set; }

    private RenderFragment Chip(string label, bool on, Func<Task> toggle) =>
        @<button type="button" class="filter-chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="toggle">
            @if (on)
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
            }
            <span>@label</span>
        </button>;

    private Task SetAsync(RecipeQuery query) => QueryChanged.InvokeAsync(query);

    private Task ClearAsync() => SetAsync(Query.Cleared() with { Search = Query.Search });

    private Task Close() => OpenChanged.InvokeAsync(false);

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
